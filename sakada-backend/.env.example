# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings → API). Never commit the real .env file.
#
# These two values are safe to expose in front-end/client-side code —
# Row Level Security (0005_rls_policies.sql) is the actual security layer,
# not keeping this key secret.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Never put this in front-end code or commit it anywhere. Server-side /
# admin scripts only, if you ever need one.
# SUPABASE_SERVICE_ROLE_KEY=